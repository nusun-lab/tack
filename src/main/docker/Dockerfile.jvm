FROM registry.access.redhat.com/ubi8/openjdk-21:1.20

ENV LANGUAGE='en_US:en'
ARG OPENSHELL_VERSION=v0.0.109

USER root

# Tack is an OpenShell client only. Install the pinned CLI RPM, not the gateway package.
RUN set -eux; \
    arch="$(uname -m)"; \
    checksums=/tmp/openshell-checksums-sha256.txt; \
    curl -fsSL "https://github.com/NVIDIA/OpenShell/releases/download/${OPENSHELL_VERSION}/openshell-checksums-sha256.txt" -o "${checksums}"; \
    rpm_name="$(awk -v arch="${arch}" '$2 ~ ("^\\*?openshell-[0-9].*\\." arch "\\.rpm$") { sub(/^\\*/, "", $2); print $2; exit }' "${checksums}")"; \
    test -n "${rpm_name}"; \
    curl -fsSL "https://github.com/NVIDIA/OpenShell/releases/download/${OPENSHELL_VERSION}/${rpm_name}" -o "/tmp/${rpm_name}"; \
    expected="$(awk -v name="${rpm_name}" '$2 == name || $2 == "*" name { print $1; exit }' "${checksums}")"; \
    echo "${expected}  /tmp/${rpm_name}" | sha256sum -c -; \
    rpm -Uvh "/tmp/${rpm_name}"; \
    rm -f "${checksums}" "/tmp/${rpm_name}"

# We make four distinct layers so if there are application changes the library layers can be re-used.
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

ADD https://repo1.maven.org/maven2/org/jolokia/jolokia-agent-jvm/2.1.1/jolokia-agent-jvm-2.1.1-javaagent.jar /opt/jolokia/jolokia-javaagent.jar

RUN chown 185:185 -R /opt/jolokia \
    && chmod -R go+r /opt/jolokia/jolokia-javaagent.jar

ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager -javaagent:/opt/jolokia/jolokia-javaagent.jar=host=0.0.0.0,port=8778,protocol=https,useSslClientAuthentication=true,caCert=/var/run/secrets/kubernetes.io/serviceaccount/service-ca.crt"

EXPOSE 8080 8778 9000
USER 185
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
