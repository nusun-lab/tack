{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRoutineStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "step",
    "routine",
    "summary",
    "nextAction",
    "actionsTaken",
    "decisions",
    "openQuestions",
    "artifactsTouched",
    "needsFollowup",
    "doneCandidate"
  ],
  "properties": {
    "role": {
      "type": "string"
    },
    "step": {
      "type": "string"
    },
    "routine": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "nextAction": {
      "type": "string"
    },
    "actionsTaken": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifactsTouched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needsFollowup": {
      "type": "boolean"
    },
    "doneCandidate": {
      "type": "boolean"
    }
  }
}
